# Optional. Without a key the app runs in demo mode with synthetic data.
# Get one at https://www.solanatracker.io/data-api
SOLANATRACKER_API_KEY=
PORT=8787

# Optional. Solana JSON-RPC endpoint for real holder wallets in the predictive engine.
# Without it, holders are a synthetic archetype population.
SOLANA_RPC_URL=
# Used to value SOL balances when computing wallet concentration.
SOL_PRICE_USD=150
